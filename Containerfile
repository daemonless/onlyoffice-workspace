ARG XMPP_SERVER_VERSION="12.0.0.134"
ARG XMPP_SERVER_SHA256="a9795bab4dc79dd9a5b1319ab5aa231ab9fcf2e9a70770653b209249eb9c868e"
ARG HYPERFASTCGI_DEB_VERSION="0.4-8"
ARG HYPERFASTCGI_DEB_SHA256="1180d1be478b7e6b96e0fce9319df854f98535073c902a38969ba29e5214be4e"
ARG HYPERFASTCGI_COMMIT="9f7f2ea886c7a686fae45969c8ced381b6d59c80"
