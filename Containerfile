        pkgconf \
        node20 && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Build FreeBSD-native libhfc-native.so.1.0.0 from ONLYOFFICE/HyperFastCGI
RUN mkdir -p /tmp/hfc /stage/usr/local/lib/mono/gac && \
    fetch -qo /tmp/hfc.tar.gz \
        "https://github.com/ONLYOFFICE/HyperFastCGI/archive/${HYPERFASTCGI_COMMIT}.tar.gz" && \
    sha256 -c "${HYPERFASTCGI_SHA256}" /tmp/hfc.tar.gz && \
    tar -xzf /tmp/hfc.tar.gz -C /tmp/hfc --strip-components=1 && \
    cd /tmp/hfc/src/libnative && \
    cc -shared -fPIC -O2 -o /stage/usr/local/lib/libhfc-native.so.1.0.0 \
        $(pkg-config --cflags glib-2.0 libevent libevent_pthreads mono-2) \
        libev.c fcgi.c fcgi-transport.c socket-helper.c mono-bridge.c \
        mono-bridge-def.c host-list.c domain-bridge.c \
        $(pkg-config --libs glib-2.0 libevent libevent_pthreads mono-2) && \
    ln -sf libhfc-native.so.1.0.0 /stage/usr/local/lib/libhfc-native.so.1 && \
    ln -sf libhfc-native.so.1.0.0 /stage/usr/local/lib/libhfc-native.so && \
    rm -rf /tmp/hfc /tmp/hfc.tar.gz

# Fetch and stage architecture-independent ONLYOFFICE Workspace packages
RUN mkdir -p /tmp/debs /stage && \
    cd /tmp/debs && \
    fetch -qo hfc.deb \
        "https://d2nlctn12v279m.cloudfront.net/repo/mono/ubuntu/pool/main/m/mono-webserver-hyperfastcgi/mono-webserver-hyperfastcgi_${HYPERFASTCGI_DEB_VERSION}_all.deb" && \
    sha256 -c "${HYPERFASTCGI_DEB_SHA256}" hfc.deb && \
    fetch -qo cs.deb \
        "https://download.onlyoffice.com/repo/debian/pool/main/o/onlyoffice-communityserver/onlyoffice-communityserver_${COMMUNITY_SERVER_VERSION}_all.deb" && \
    sha256 -c "${COMMUNITY_SERVER_SHA256}" cs.deb && \
    fetch -qo cp.deb \
        "https://download.onlyoffice.com/repo/debian/pool/main/o/onlyoffice-controlpanel/onlyoffice-controlpanel_${CONTROL_PANEL_VERSION}_all.deb" && \
    sha256 -c "${CONTROL_PANEL_SHA256}" cp.deb && \
    fetch -qo xmpp.deb \
        "https://download.onlyoffice.com/repo/debian/pool/main/o/onlyoffice-xmppserver/onlyoffice-xmppserver_${XMPP_SERVER_VERSION}_all.deb" && \
    sha256 -c "${XMPP_SERVER_SHA256}" xmpp.deb && \
    for deb in hfc.deb cs.deb cp.deb xmpp.deb; do \
        mkdir /tmp/debs/ext && \
        cd /tmp/debs/ext && \
        tar -xf "../${deb}" && \
        tar -xf data.tar.* -C /stage && \
        cd /tmp/debs && \
        rm -rf /tmp/debs/ext "${deb}"; \
    done && \
    mv /stage/usr/lib/hyperfastcgi /stage/usr/local/lib/ && \
    mv /stage/usr/lib/mono/gac/HyperFastCgi /stage/usr/local/lib/mono/gac/ && \
    rm -rf /tmp/debs /stage/usr/lib /stage/usr/bin /stage/usr/share /stage/lib /stage/etc/god \
        /stage/var/www/onlyoffice/Services/MailAggregator \
        /stage/var/www/onlyoffice/Services/MailCleaner \
        /stage/var/www/onlyoffice/Services/MailImap \
        /stage/var/www/onlyoffice/Services/MailWatchdog && \
    find /stage/var/www/onlyoffice/Services -name 'libSystem.IO.Ports.Native.so' -delete && \
    mkdir -p /var/log/onlyoffice && \
    cd /stage/var/www/onlyoffice/controlpanel/www && \
    # Pre-generate the Control Panel JS bundle and verify its Node modules load on FreeBSD at build time.
    NODE_ENV=production /usr/local/bin/node -e "require('./app'); setTimeout(() => process.exit(0), 2000);" && \
    chmod -R a+rX /stage

