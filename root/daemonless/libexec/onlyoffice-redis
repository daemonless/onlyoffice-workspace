#!/bin/sh
REDIS_HOST="${REDIS_SERVER_HOST:-127.0.0.1}"
REDIS_PORT="${REDIS_SERVER_PORT:-6379}"
if [ "${REDIS_HOST}" != "127.0.0.1" ] && [ "${REDIS_HOST}" != "localhost" ]; then
    exec sleep 86400
fi
exec dsu bsd /usr/local/bin/redis-server \
    --bind 127.0.0.1 \
    --port "${REDIS_PORT}" \
    --save "" \
    --appendonly no \
    --dir /tmp \
    --daemonize no
