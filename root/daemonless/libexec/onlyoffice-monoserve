#!/bin/sh
export LD_LIBRARY_PATH="/usr/local/lib"
export MONO_PATH="/var/www/onlyoffice/WebStudio/bin/"
export MONO_IOMAP="all"
export MONO_ASPNET_WEBCONFIG_CACHESIZE="2000"
export MONO_THREADS_PER_CPU="2000"
export MONO_GC_PARAMS="nursery-size=128m,soft-heap-limit=512m,bridge-implementation=tarjan"
export MONO_LOG_LEVEL="error"
export MONO_THREADS_SUSPEND="preemptive"

rm -f /var/run/onlyoffice/onlyoffice.socket

# Background warm-up once FastCGI socket and Nginx are listening
(
    for _i in $(seq 1 60); do
        if [ -S /var/run/onlyoffice/onlyoffice.socket ]; then
            break
        fi
        sleep 1
    done
    sleep 2
    _port="${HTTP_PORT:-8080}"
    fetch -qo /dev/null -T 180 "http://127.0.0.1:${_port}/api/2.0/capabilities.json" 2>/dev/null || true
    fetch -qo /dev/null -T 180 "http://127.0.0.1:${_port}/Wizard.aspx" 2>/dev/null || true
    echo "[onlyoffice-workspace] Portal ready on port ${_port}"
) &

exec dsu bsd /usr/local/bin/mono /usr/local/lib/hyperfastcgi/4.0/HyperFastCgi.exe \
    /config=/etc/hyperfastcgi/onlyoffice \
    /logfile=/var/log/onlyoffice/onlyoffice.log \
    /loglevels=Error
